<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Billing_Frequency</name>
        <label>Set Billing Frequency</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.BillingFrequency</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BillingFrequencyFromTermUnit</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Period_Boundary_Blank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Period_Boundary</name>
        <label>Set Period Boundary</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>$Record.PeriodBoundary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Anniversary</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Recurring_Selling_Model</name>
        <label>Is Recurring Selling Model</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Not Recurring</defaultConnectorLabel>
        <rules>
            <name>Recurring</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PricebookEntry.ProductSellingModel.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TermDefined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PricebookEntry.ProductSellingModel.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evergreen</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BillingFrequencyFromTermUnit</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Billing_Frequency</targetReference>
            </connector>
            <label>Recurring</label>
        </rules>
    </decisions>
    <decisions>
        <name>Period_Boundary_Blank</name>
        <label>Period Boundary Blank</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Keep Period Boundary</defaultConnectorLabel>
        <rules>
            <name>Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PeriodBoundary</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Period_Boundary</targetReference>
            </connector>
            <label>Blank</label>
        </rules>
    </decisions>
    <description>Before-save (Create): defaults BillingFrequency (from the selling model's PricingTermUnit: Months -&gt; Monthly, Annual -&gt; Annual, Quarterly, Semi-Annual, Weekly) and PeriodBoundary (Anniversary) on new TermDefined/Evergreen quote lines that arrive without them. Billing rejects such lines with "When the SellingModelType is Evergreen or Term-Defined, BillingFrequency can't be null", and callers that cannot send the field (e.g. the revenue-cloud MCP createSalesTransaction tool) would otherwise be unable to quote any subscription product. Values that are already set are never overwritten, and OneTime lines are left untouched because they must not carry a billing frequency. Requires BillingTreatment.CanChangeBillingFrequency = true on the line's treatment.</description>
    <environments>Default</environments>
    <formulas>
        <name>BillingFrequencyFromTermUnit</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.PricebookEntry.ProductSellingModel.PricingTermUnit}), &quot;Months&quot;, &quot;Monthly&quot;, &quot;Annual&quot;, &quot;Annual&quot;, &quot;Quarterly&quot;, &quot;Quarterly&quot;, &quot;Semi-Annual&quot;, &quot;Semi-Annual&quot;, &quot;Weekly&quot;, &quot;Weekly&quot;, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>RLM Default Quote Line Billing Frequency {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Default Quote Line Billing Frequency</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Recurring_Selling_Model</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillingFrequency</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PricebookEntryId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
