<?xml version="1.0" encoding="UTF-8"?>
<!--
  Carries the lead's Budget into the converted opportunity's Amount.
  LeadConvertSettings cannot do this: lead conversion only maps a custom field onto
  another custom field, never onto a standard one like Amount.

  Only Amount changes, so ISCHANGED(StageName) stays false and neither stage
  validation rule fires.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>RLM Entirely Lead Budget To Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Entirely Lead Budget To Amount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Opportunity_Amount</name>
        <label>Set Opportunity Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>$Record.RLM_Budget__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Opportunity_Amount</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.IsConverted},
  NOT(ISBLANK({!$Record.ConvertedOpportunityId})),
  NOT(ISBLANK({!$Record.RLM_Budget__c}))
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
