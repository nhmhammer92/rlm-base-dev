<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RLM_Regional_Exception__c</fullName>
    <externalId>false</externalId>
    <formula>AND(
  NOT(ISBLANK(TEXT(RLM_Territory__c))),
  NOT(ISBLANK(RLM_Owner_Territory__c)),
  TEXT(RLM_Territory__c) &lt;&gt; RLM_Owner_Territory__c
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <inlineHelpText>True when the deal sits outside the owner&apos;s territory, which requires regional ownership approval.</inlineHelpText>
    <label>Regional Exception</label>
    <trackHistory>false</trackHistory>
    <trackFeedHistory>false</trackFeedHistory>
    <type>Checkbox</type>
</CustomField>
